# RankForge website — environment variables (TEMPLATE)
# Copy this file to ".env.local" (or ".env") and fill in values for local dev.
# Real env files are git-ignored — NEVER commit secrets to the repo.

# Optional: endpoint the early-access waitlist form POSTs signups to.
# Leave blank to keep the form fully client-side (no backend required).
# Examples: a Formspree form URL, a Google Apps Script web-app URL, or your own API.
NEXT_PUBLIC_WAITLIST_ENDPOINT=
